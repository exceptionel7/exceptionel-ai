# Copy to ".env" and fill in. This file is git-ignored — never commit real secrets.

# Secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_JWT_SECRET=

# Supabase (enables real persistence). Leave empty to use in-memory demo mode.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional server port (local)
PORT=7000
