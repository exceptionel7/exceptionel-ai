{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node", "config": { "maxDuration": 60 } },
    { "src": "index.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js?__path=$1" },
    { "handle": "filesystem" },
    { "src": "/", "dest": "/index.html" }
  ]
}
