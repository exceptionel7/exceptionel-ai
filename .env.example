# Copiez ce fichier en ".env" puis remplissez-le.
# Le fichier .env est ignoré par Git : vos clés ne partiront JAMAIS sur GitHub.

# Clé API OpenAI (pour le studio de contenu). Sans elle : mode démo hors-ligne.
OPENAI_API_KEY=

# Modèle OpenAI (optionnel)
OPENAI_MODEL=gpt-4o-mini

# Port du serveur (optionnel)
PORT=3000
