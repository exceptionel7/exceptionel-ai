# Copiez ce fichier en ".env" (dans le dossier sales-chatbot/) puis remplissez-le.
# Le fichier .env est ignoré par Git : votre clé ne partira JAMAIS sur GitHub.

# Clé API Anthropic (Claude). Sans elle, le chatbot tourne en mode hors-ligne.
ANTHROPIC_API_KEY=

# Modèle Claude à utiliser (optionnel)
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Port du serveur (optionnel)
PORT=4000
